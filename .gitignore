# 构建产物
build/
build-*/
cmake-build-*/
*.o
*.obj

# 打包目录里的二进制与 Qt 运行库（体积大，按需自行 windeployqt）
dist/*
!dist/samples/
!dist/samples/*.cfproj

# JSON 接口的默认输出目录
out/
_apitest*/
_mixed.json

# 地图成品图体积大，可随时由 maps/*.json 重新渲染（保留预览图除外）
maps/*.png
!maps/preview.png
!maps/preview-*.png

# 编辑器 / 系统
.vs/
.idea/
.vscode/
*.user
*.autosave
Thumbs.db
desktop.ini
